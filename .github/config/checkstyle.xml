<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Project Standards - Checkstyle Configuration
    
    Bu konfigürasyon, kod standartlarını otomatik olarak kontrol eder.
    
    Kullanım:
    mvn checkstyle:check
    
    Versiyon: 2.0.0
    Son Güncelleme: Aralık 2024
-->

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- Excludes all 'module-info.java' files -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="module-info\.java$"/>
    </module>

    <!-- ==================== FILE LEVEL CHECKS ==================== -->

    <!-- Dosya uzunluğu: max 2000 satır -->
    <module name="FileLength">
        <property name="max" value="2000"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <!-- Tab karakteri yerine space kullanılmalı -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Satır uzunluğu: max 120 karakter (import/package hariç) -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <!-- ==================== TREE WALKER CHECKS ==================== -->

    <module name="TreeWalker">
    
        <!-- ========== NAMING CONVENTIONS ========== -->
        
        <!-- Constant isimlendirme: UPPER_SNAKE_CASE -->
        <module name="ConstantName"/>
        
        <!-- Local final variable isimlendirme -->
        <module name="LocalFinalVariableName"/>
        
        <!-- Local variable isimlendirme: camelCase -->
        <module name="LocalVariableName"/>
        
        <!-- Member variable isimlendirme: camelCase -->
        <module name="MemberName"/>
        
        <!-- Method isimlendirme: camelCase -->
        <module name="MethodName"/>
        
        <!-- Package isimlendirme: lowercase -->
        <module name="PackageName"/>
        
        <!-- Parameter isimlendirme: camelCase -->
        <module name="ParameterName"/>
        
        <!-- Static variable isimlendirme -->
        <module name="StaticVariableName"/>
        
        <!-- Type (class/interface) isimlendirme: PascalCase -->
        <module name="TypeName"/>

        <!-- ========== IMPORT CHECKS ========== -->
        
        <!-- Star import yasak: import java.util.*; -->
        <module name="AvoidStarImport"/>
        
        <!-- Illegal imports (sun.* packages) -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun"/>
        </module>
        
        <!-- Redundant import (duplicate) -->
        <module name="RedundantImport"/>
        
        <!-- Kullanılmayan import'lar -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="false"/>
        </module>

        <!-- ========== SIZE VIOLATIONS ========== -->
        
        <!-- Metod uzunluğu: max 80 satır -->
        <module name="MethodLength">
            <property name="max" value="80"/>
        </module>
        
        <!-- Parametre sayısı: max 7 -->
        <module name="ParameterNumber">
            <property name="max" value="7"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>

        <!-- ========== WHITESPACE ========== -->
        
        <module name="EmptyForIteratorPad"/>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="NoWhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="OperatorWrap"/>
        <module name="ParenPad"/>
        <module name="TypecastParenPad"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
        </module>

        <!-- ========== MODIFIER CHECKS ========== -->
        
        <!-- Modifier sıralaması: public static final -->
        <module name="ModifierOrder"/>
        
        <!-- Gereksiz modifier'lar -->
        <module name="RedundantModifier"/>

        <!-- ========== BLOCK CHECKS ========== -->
        
        <!-- Gereksiz nested block'lar -->
        <module name="AvoidNestedBlocks"/>
        
        <!-- Boş block'lar yasak -->
        <module name="EmptyBlock"/>
        
        <!-- Sol süslü parantez aynı satırda -->
        <module name="LeftCurly"/>
        
        <!-- If/for/while için süslü parantez zorunlu -->
        <module name="NeedBraces"/>
        
        <!-- Sağ süslü parantez kuralları -->
        <module name="RightCurly"/>

        <!-- ========== CODING PROBLEMS ========== -->
        
        <!-- Boş statement (;) yasak -->
        <module name="EmptyStatement"/>
        
        <!-- equals() ve hashCode() birlikte override edilmeli -->
        <module name="EqualsHashCode"/>
        
        <!-- Hidden field kontrolü (parametre ile field aynı isim) -->
        <module name="HiddenField">
            <property name="tokens" value="VARIABLE_DEF"/>
            <property name="ignoreConstructorParameter" value="true"/>
            <property name="ignoreSetter" value="true"/>
        </module>
        
        <!-- Illegal instantiation (Boolean, String için new kullanma) -->
        <module name="IllegalInstantiation"/>
        
        <!-- Assignment içinde assignment yasak -->
        <module name="InnerAssignment"/>
        
        <!-- Magic number kontrolü (sabit kullan) -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
        </module>
        
        <!-- Switch'te default case zorunlu -->
        <module name="MissingSwitchDefault"/>
        
        <!-- Bir satırda birden fazla variable declaration yasak -->
        <module name="MultipleVariableDeclarations"/>
        
        <!-- Boolean expression sadeleştirme -->
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <!-- ========== CLASS DESIGN ========== -->
        
        <!-- Final class'lar için constructor private olmalı -->
        <module name="FinalClass"/>
        
        <!-- Utility class constructor hidden olmalı -->
        <module name="HideUtilityClassConstructor"/>
        
        <!-- Interface sadece type olarak kullanılmalı (constant interface yasak) -->
        <module name="InterfaceIsType"/>

        <!-- ========== MISCELLANEOUS ========== -->
        
        <!-- Array declaration: String[] args (String args[] değil) -->
        <module name="ArrayTypeStyle"/>
        
        <!-- TODO comment uyarısı -->
        <module name="TodoComment">
            <property name="severity" value="info"/>
        </module>
        
        <!-- Long literal için L kullan (l değil) -->
        <module name="UpperEll"/>

        <!-- ========== JAVADOC ========== -->
        
        <!-- Public method Javadoc (opsiyonel) -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowMissingParamTags" value="true"/>
            <property name="allowMissingReturnTag" value="true"/>
        </module>
        
        <!-- Public type Javadoc -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
            <property name="allowMissingParamTags" value="true"/>
        </module>
        
        <!-- Javadoc style kontrolü -->
        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="false"/>
        </module>

        <!-- ========== @AUTOWIRED YASAĞI ========== -->
        
        <!-- 
            @Autowired field injection YASAKTIR!
            Constructor injection ile @RequiredArgsConstructor kullanın.
            
            Detaylı bilgi: docs/CODING_STANDARDS.md - Bölüm 4
        -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="^\s*@Autowired"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="@Autowired kullanımı YASAKTIR! Constructor injection ile @RequiredArgsConstructor kullanın. Detay: docs/CODING_STANDARDS.md"/>
        </module>

    </module>

</module>
