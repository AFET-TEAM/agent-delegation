<!--
    Project Standards - Maven Quality Plugins Template
    
    Bu template, pom.xml dosyanıza quality kontrol plugin'lerini eklemek için kullanılır.
    
    Kullanım:
    1. Bu dosyadaki plugin konfigürasyonlarını pom.xml'inizin <build><plugins> bölümüne ekleyin
    2. Properties bölümüne şunu ekleyin:
       <quality.dir>${project.basedir}/project-standards/config</quality.dir>
    3. Profile bölümüne quality-checks profile'ını ekleyin (dosyanın sonunda)
    
    Not: Bu template sadece plugin konfigürasyonlarını içerir.
    Dependency'ler ve diğer konfigürasyonlar projeye özeldir.
    
    Versiyon: 2.0.0
    Son Güncelleme: Aralık 2024
-->

<!-- ============================================ -->
<!-- QUALITY PLUGINS - Build Section'e Eklenecek -->
<!-- ============================================ -->

<!-- JaCoCo Plugin - Test Coverage -->
<plugin>
    <groupId>org.jacoco</groupId>
    <artifactId>jacoco-maven-plugin</artifactId>
    <version>0.8.12</version>
    <configuration>
        <excludes>
            <exclude>**/target/generated-sources/**</exclude>
            <exclude>**/dto/**</exclude>
            <exclude>**/model/**</exclude>
            <exclude>**/entity/**</exclude>
            <exclude>**/repository/**</exclude>
            <exclude>**/*Application.class</exclude>
            <exclude>**/config/**</exclude>
        </excludes>
    </configuration>
    <executions>
        <execution>
            <goals>
                <goal>prepare-agent</goal>
            </goals>
        </execution>
        <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
                <goal>report</goal>
            </goals>
        </execution>
    </executions>
</plugin>

<!-- SonarQube Maven Plugin -->
<plugin>
    <groupId>org.sonarsource.scanner.maven</groupId>
    <artifactId>sonar-maven-plugin</artifactId>
    <version>3.10.0.2594</version>
    <configuration>
        <!-- SonarQube server URL - environment variable veya projeye özel ayarlayın -->
        <sonarHostUrl>${SONAR_HOST_URL}</sonarHostUrl>
        <!-- Projeye özel projectKey ekleyin -->
        <!-- <sonar.projectKey>{project-key}</sonar.projectKey> -->
    </configuration>
</plugin>

<!-- Maven Compiler Plugin with Lombok annotation processing -->
<plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-compiler-plugin</artifactId>
    <configuration>
        <source>${maven.compiler.source}</source>
        <target>${maven.compiler.target}</target>
        <parameters>true</parameters>
        <compilerArgs>
            <arg>--add-opens</arg>
            <arg>jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
            <arg>--add-opens</arg>
            <arg>jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
            <arg>--add-opens</arg>
            <arg>jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
        </compilerArgs>
        <annotationProcessorPaths>
            <!-- Lombok -->
            <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </path>
            <!-- MapStruct (opsiyonel) -->
            <!--
            <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </path>
            -->
        </annotationProcessorPaths>
    </configuration>
</plugin>

<!-- Surefire Plugin Configuration -->
<plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-surefire-plugin</artifactId>
    <version>3.2.5</version>
    <configuration>
        <forkCount>1C</forkCount>
        <reuseForks>true</reuseForks>
        <trimStackTrace>true</trimStackTrace>
        <printSummary>true</printSummary>
        <useSystemClassLoader>false</useSystemClassLoader>
        <redirectTestOutputToFile>true</redirectTestOutputToFile>
        <reportFormat>brief</reportFormat>
        <systemPropertyVariables>
            <spring.profiles.active>test</spring.profiles.active>
            <logging.level.org.springframework>ERROR</logging.level.org.springframework>
            <logging.level.org.hibernate>ERROR</logging.level.org.hibernate>
            <logging.level.org.junit>ERROR</logging.level.org.junit>
        </systemPropertyVariables>
        <argLine>${argLine} --add-opens java.base/java.lang=ALL-UNNAMED --add-opens
            java.base/java.util=ALL-UNNAMED --add-opens java.base/java.time=ALL-UNNAMED --add-opens
            java.base/java.lang.invoke=ALL-UNNAMED -Djdk.attach.allowAttachSelf=true
        </argLine>
    </configuration>
</plugin>

