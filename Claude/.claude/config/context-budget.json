{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "description": "Machine-readable context budget per tier, mirrors context-budget.md",
  "canonical_source": ".claude/config/tier-definitions.md",
  "tiers": {
    "orchestrator": {
      "model": "opus",
      "fallback": ["sonnet"],
      "max_input_tokens": 200000,
      "max_output_tokens": 32000,
      "max_skills": null,
      "max_pcd_files": null,
      "role": "coordination-only, read-only on application code"
    },
    "T1": {
      "model": "opus",
      "fallback": ["sonnet"],
      "max_skills": 5,
      "max_pcd_files": 10,
      "max_tokens_per_task": 8000
